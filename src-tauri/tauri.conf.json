{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GaussBoard",
  "version": "7.0.2",
  "identifier": "com.gaussboard.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GaussBoard",
        "url": "app://board/index.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "resizable": true
      },
      {
        "label": "splashscreen",
        "title": "GaussBoard",
        "url": "app://board/splash.html",
        "width": 420,
        "height": 300,
        "decorations": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' app: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' app: data: blob:; media-src 'self' app: data: blob:; connect-src 'self' app: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../src/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
