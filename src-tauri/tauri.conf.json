{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GaussBoard",
  "version": "1.0.0",
  "identifier": "com.gaussboard.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GaussBoard",
        "url": "app://board/index.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "resizable": true
      },
      {
        "label": "splashscreen",
        "title": "GaussBoard",
        "url": "app://board/splash.html",
        "width": 420,
        "height": 300,
        "decorations": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' app: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' app: data: blob:; media-src 'self' app: data: blob:; connect-src 'self' app: ipc: http://ipc.localhost"
    }
  }
}
