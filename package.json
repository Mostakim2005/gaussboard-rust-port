    }
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "4.10.38"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2"
  }
