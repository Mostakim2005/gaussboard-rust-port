{
  "name": "gaussboard-rust-port",
  "productName": "GaussBoard",
  "version": "7.0.2",
  "description": "GaussBoard (Rust & Tauri v2 Port) — An offline digital whiteboard & STEM engineering workstation for electrical engineering students, powered by Rust native engines and Tauri v2.",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "tauri build",
    "smoke": "node scripts/smoke.js",
    "smoke:new": "node scripts/smoke.js --new-features",
    "i18n:check": "node scripts/i18n-check.js",
    "smoke:replay": "node --test test/replay-reading.test.mjs test/audio-bar.test.mjs",
    "smoke:video": "node --test test/video-framing.test.mjs",
    "build:web": "node scripts/build-web.js",
    "serve:web": "node scripts/serve-web.js",
    "dev:web": "node scripts/serve-web.js",
    "test:web": "npm run build:web && node test/web-pwa.test.js",
    "test": "npm run smoke && npm run i18n:check",
    "test:tablet": "node test/tablet-layout.test.js",
    "test:android": "node --test test/android-*.test.js",
    "sync:receive": "node scripts/sync-demo.js receive",
    "sync:send": "node scripts/sync-demo.js send",
    "sync:discover": "node scripts/sync-demo.js discover",
    "build:sync-demo": "node scripts/build-sync-demo.js"
  },
  "author": {
    "name": "Kazi S. Mostakim",
    "email": "kazi.s.mostakim@gmail.com"
  },
  "homepage": "https://github.com/Mostakim2005/gaussboard-rust-port",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mostakim2005/gaussboard-rust-port.git"
  },
  "contributors": [
